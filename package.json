{
  "name": "spire-slice",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "sprites": "node scripts/generate-creature-sprites.mjs",
    "terrain": "node scripts/generate-map-terrain.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5175 electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.10"
  },
  "build": {
    "appId": "nz.co.somar.slaythefish",
    "productName": "Slay the Fish",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
